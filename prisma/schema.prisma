generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String @id @default(uuid())
  username String @unique
  password String
  avatar   String?
  email    String @unique
  posts    Post[]
  likes    Like[]
  comments Comment[]
  blocklist Blocklist[]

  @@map("users")
}

model Post {
  id        String    @id @default(uuid())
  title     String
  content   String
  published Boolean   @default(false)
  createdAt DateTime  @default(now())
  userId    String
  likes     Like[]
  comments  Comment[]
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("posts")
}

model Comment {
  id       String  @id @default(uuid())
  content  String
  userId   String?
  createdAt DateTime  @default(now())
  postId   String
  type     CommentType
  post     Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  user     User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([postId])
  @@map("comments")
}

model Like {
  id String @id @default(uuid())
  userId String
  postId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])  // ONE like per user per post
  @@index([postId])
  @@index([userId])
  @@map("likes")
}

model Blocklist {
  id String @id @default(uuid())
  userId String
  token String @unique
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("blockList")
}

enum CommentType {
  PUBLIC
  PRIVATE
}
